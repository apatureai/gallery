{
  "$description": "Meridian design tokens (DTCG). Machine-readable mirror of src/tokens.css; `scripts/check-tokens.mjs` fails if the two drift.",
  "color": {
    "brand": {
      "50": { "$type": "color", "$value": "#eef2ff" },
      "100": { "$type": "color", "$value": "#e0e7ff" },
      "300": { "$type": "color", "$value": "#a5b4fc" },
      "500": { "$type": "color", "$value": "#6366f1" },
      "600": { "$type": "color", "$value": "#4f46e5" },
      "700": { "$type": "color", "$value": "#4338ca" }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f8fafc" },
      "100": { "$type": "color", "$value": "#f1f5f9" },
      "200": { "$type": "color", "$value": "#e2e8f0" },
      "300": { "$type": "color", "$value": "#cbd5e1" },
      "400": { "$type": "color", "$value": "#94a3b8" },
      "500": { "$type": "color", "$value": "#64748b" },
      "600": { "$type": "color", "$value": "#475569" },
      "700": { "$type": "color", "$value": "#334155" },
      "800": { "$type": "color", "$value": "#1e293b" },
      "900": { "$type": "color", "$value": "#0f172a" }
    },
    "success": {
      "100": { "$type": "color", "$value": "#dcfce7" },
      "700": { "$type": "color", "$value": "#15803d" }
    },
    "warning": {
      "100": { "$type": "color", "$value": "#fef3c7" },
      "700": { "$type": "color", "$value": "#b45309" }
    },
    "danger": {
      "100": { "$type": "color", "$value": "#fee2e2" },
      "700": { "$type": "color", "$value": "#b91c1c" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "18px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "0.875rem" },
    "base": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.125rem" },
    "xl": { "$type": "dimension", "$value": "1.375rem" },
    "2xl": { "$type": "dimension", "$value": "1.75rem" },
    "3xl": { "$type": "dimension", "$value": "2.25rem" },
    "4xl": { "$type": "dimension", "$value": "3rem" }
  },
  "target": {
    "min": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Minimum hit area for any interactive element (WCAG 2.5.8 AA)."
    }
  }
}
